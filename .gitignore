# OS / IDE
# =========================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
# experimental live-cycle bundles are runtime output of the worker (docs/139)
data/live/
# IMD-derived pair caches and the 1.6 GB reforecast cache stay local (IMD redistribution rights unresolved, docs/80; reproducible by the scripts)
data/processed/reforecast_control_v1/
data/processed/regime_tasks_v1/
# Forecast-only 2026 feature arrays and their per-cycle manifests are local,
# hash-receipted research cache; checked-in month summaries describe the stage.
data/processed/gefs_2026_forecast_only_v1/
data/processed/partial_grid_candidate_v1/
data/processed/coherent_partial_grid_v1/
data/processed/lead_aware_probability_v1/
data/processed/june_probability_transport_v1/
data/processed/expert_regime_review_v1/
data/processed/gefs_2026_frozen_inference_v1/
# Locally held reviewer templates and east-coast research arrays; their small
# manifests and SHA receipts are tracked separately.
data/processed/expert_regime_review_handoff_v1/
data/processed/east_coast_static_v1/
data/processed/east_coast_development_v1/
# Local 2023/2024 nationwide forecast feature and prediction arrays (200 MB).
# Small hash manifests remain reviewable under data/manifests/research_pilot.
data/processed/nationwide_research_v1/
# Separate local 2023-fit/2024-sealed probability repair arrays (docs/168).
data/processed/nationwide_probability_v2/
# Local pytest basetemp directories created by Windows test runs.
data/pytest-*/
# local assistant/editor session config
.claude/
# Hash-manifested evidence arrays that the read-only API serves (docs/143) are tracked even though other binary arrays are not
!backend/app/evidence_data/**/*.npz

# Launch-video renders and frames (large, regenerated locally)
brag-output/

# =========================================================
# Unused Legacy Frontend (quarantined prototype)
# =========================================================
frontend/

# =========================================================
# Root text dumps and obsolete scratch files
# =========================================================
folder_tree.txt
LAST_MODIFIED*.txt

